{
  "expo": {
    "name": "TikTok",
    "slug": "tiktok-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tiktokexpo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tiktok.expo"
    },
    "android": {
      "package": "com.tiktok.expo",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TikTok to record videos.",
          "microphonePermission": "Allow TikTok to record audio with videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TikTok to select videos from your library."
        }
      ]
    ]
  }
}
